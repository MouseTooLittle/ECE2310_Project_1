{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sensor_analyzer",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "sensor_tools.cpp",
                "main.cpp",
                "-o",
                "sensor_analyzer.exe"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}